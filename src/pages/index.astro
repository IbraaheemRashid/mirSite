---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="MIR">
	<header>
		<div class="contact-list">
			<a href="https://github.com/IbraaheemRashid" target="_blank" rel="noopener noreferrer">github</a>
			<a href="https://www.linkedin.com/in/ibraaheem-rashid-09a81723a/" target="_blank" rel="noopener noreferrer">linkedin</a>
			<a href="mailto:ibraaheemrashid@hotmail.com">email</a>
		</div>
	</header>
	<main>
		<div class="title-section">
			<h1>MIR</h1>
			<p class="subtitle">a place for my stuff</p>
		</div>

		<div class="content">
			<h2>projects</h2>
			<ul>
				<li>
					<a href="https://github.com/IbraaheemRashid/EducationalChatbot" target="_blank" rel="noopener noreferrer">EDUBOT</a>
					<span class="description">- a way for you to speak to your documents.</span>
				</li>
				<li>
					<a href="https://github.com/IbraaheemRashid/robotinoMovement" target="_blank" rel="noopener noreferrer">Robotino Navigation Stack</a>
					<span class="description">- autonomous navigation system for the Festo Robotino 3 using ROS 2, SLAM, Nav2, and reinforcement learning.</span>
				</li>
			</ul>

			<h2>essays</h2>
			<ul>
				{essays.map((essay) => (
					<li>
						<a href={`/essays/${essay.slug}`}>{essay.data.title}</a>
						<span class="description">- {essay.data.description}</span>
					</li>
				))}
			</ul>
		</div>
	</main>
</Layout>

<style>
	:root {
		--text-color: #C6D0F5;
		--bg-color: #303446;
		--link-color: #8CAAEE;
		--link-hover-color: #B5BFE2;
		--description-color: #838BA7;
		--header-bg-color: #292C3C;
	}

	body {
		font-family: monospace;
		font-size: 1.1rem;
		background-color: var(--bg-color);
		color: var(--text-color);
		line-height: 1.6;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		margin: 0;
		padding: 0;
	}

	header {
		background-color: var(--header-bg-color);
		padding: 0.75rem 1rem;
		text-align: left;
	}

	.contact-list {
		display: flex;
		gap: 1rem;
	}

	main {
		max-width: 800px;
		margin: 2rem auto;
		padding: 0 1rem;
		flex-grow: 1;
	}

	.title-section {
		margin-bottom: 2rem;
	}

	h1 {
		font-size: 2rem;
		font-weight: bold;
		margin-bottom: 0.5rem;
	}

	.subtitle {
		color: var(--description-color);
	}

	h2 {
		font-size: 1.4rem;
		margin-top: 2rem;
		margin-bottom: 0.5rem;
	}

	ul {
		list-style-type: none;
		padding: 0;
	}

	li {
		margin-bottom: 0.5rem;
	}

	a {
		color: var(--link-color);
		text-decoration: underline;
	}

	a:hover {
		color: var(--link-hover-color);
	}

	.description {
		color: var(--description-color);
	}
</style>
